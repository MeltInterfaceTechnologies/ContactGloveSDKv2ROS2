Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.1
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel (Left)
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: left/robot_description
      TF Prefix: "contact_glove"
      Value: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Mass Properties:
        Inertia: false
        Mass: false
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel (Right)
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: right/robot_description
      TF Prefix: "contact_glove"
      Value: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Mass Properties:
        Inertia: false
        Mass: false
      Update Interval: 0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.6
      Name: Current View
      Pitch: 0.3
      Target Frame: <Fixed Frame>
      Yaw: 1.57
Window Geometry:
  Height: 800
  Width: 1200
  X: 0
  Y: 0
