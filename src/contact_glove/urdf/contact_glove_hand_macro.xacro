<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="contact_glove_hand_macro">
  <!--
    Common macro for ContactGlove hand models. It is included by
    urdf/left_hand.urdf.xacro and urdf/right_hand.urdf.xacro, which invoke
    contact_glove_hand with prefix="left_" or "right_" and the corresponding
    joint-origin and length parameters.

    Ergonomics.msg (degrees) -> JointState (radians):
      Every joint name exactly matches the name generated by
      contact_glove::to_joint_state() in src/conversions.cpp:
      "<left|right>_<finger>_<field>_joint"
      (for example, left_thumb_cmc_joint and right_index_tilt_joint).
      The conversion is degrees to radians only; it does not invert signs
      between hands.

    Joint positions, rotations (joint origins), and the rest pose use calibrated
    hand geometry derived from measured reference points.
    DOFs without a corresponding Ergonomics value are not generated as joints:
    mcp_rot on each finger; cmc_rot and mcp_rot on the thumb; and cmc_flex on
    the little finger. Their rest-pose (zero-angle) transforms are composed
    into an adjacent joint origin. Although the little-finger cmc_flex DOF has
    a practical range of motion, it has no Ergonomics value, so its rest-pose
    transform is composed into the tilt joint origin and it remains at zero.
    Joint axes use the model's unmodified geometric axes: for all fingers,
    tilt is Y and flexion is X; for the thumb, cmc is Y, tilt is Z, and mcp/ip
    are X.
    The left and right rest poses (all joint angles zero) were verified as
    exact mirrors by reflecting the Z coordinates of the raw bind points and
    re-running the same bind-frame geometry derivation.

    Mirrored rest poses alone do not guarantee mirrored motion for non-zero
    joint angles. Re-running geometric_bind_frame_with_hint (which builds
    local X/Y axes using cross products) on Z-reflected raw bind points causes
    an additional sign inversion for rotations around Z and Y, but not around
    X; numeric forward-kinematics verification confirms this behavior. Therefore,
    applying the same signed joint
    angle on both hands does not mirror motion for tilt (abduction/adduction:
    Y for the four fingers and Z for the thumb) or thumb cmc flexion (Y).
    The `reflect` parameter (right = 1, left = -1) corrects this by
    inverting only the Y/Z joint-axis vector signs on the left. X-axis joints
    (mcp/pip/dip/ip flexion) need no inversion; numerical verification found
    zero error. Joint limits use calibrated lower and upper ranges and are not
    precise hardware specifications.
    The model is for visualization and joint hierarchy only; it does not
    define collision or inertial properties and is outside the scope of
    physical simulation.

    Each link visual is a simple cylinder (cg_cylinder_link) between joints,
    not an anatomical hand mesh. Cylinder lengths are the distances between
    calibrated reference points (the norms of joint-origin translations); radii
    are visual estimates, not measurements. Tilt-link children use a small
    sphere (cg_pivot_link) because their origin to the next joint is always
    the identity transform rather than a non-zero cylinder length.
  -->

  <xacro:property name="joint_effort" value="5.0"/>
  <xacro:property name="joint_velocity" value="5.0"/>

  <!-- Uses calibrated lower and upper joint limits (radians).
       Shared by the four fingers: index, middle, ring, and little. -->
  <xacro:property name="tilt_lower" value="-0.85"/>
  <xacro:property name="tilt_upper" value="0.85"/>
  <xacro:property name="mcp_lower" value="-1.1344640137963142"/>
  <xacro:property name="mcp_upper" value="1.66"/>
  <xacro:property name="pip_lower" value="-0.5235987755982988"/>
  <xacro:property name="pip_upper" value="2.00"/>
  <xacro:property name="dip_lower" value="-0.3490658503988659"/>
  <xacro:property name="dip_upper" value="1.75"/>

  <xacro:property name="thumb_cmc_lower" value="-1.1344640137963142"/>
  <xacro:property name="thumb_cmc_upper" value="2.62"/>
  <xacro:property name="thumb_tilt_lower" value="-0.70"/>
  <xacro:property name="thumb_tilt_upper" value="0.70"/>
  <xacro:property name="thumb_mcp_lower" value="-1.1344640137963142"/>
  <xacro:property name="thumb_mcp_upper" value="1.85"/>
  <xacro:property name="thumb_ip_lower" value="-0.6981317007977318"/>
  <xacro:property name="thumb_ip_upper" value="1.85"/>

  <!-- Cylinder length for each segment, equal to the calibrated reference-point distance.
       The hands are mirrors created by reflecting raw bind-point Z coordinates and
       re-running the same geometry derivation, so lengths are shared. -->
  <xacro:property name="thumb_cmc_len" value="0.035171"/>
  <xacro:property name="thumb_mcp_len" value="0.022226"/>
  <xacro:property name="thumb_ip_len" value="0.027821"/>
  <xacro:property name="index_mcp_len" value="0.030304"/>
  <xacro:property name="index_pip_len" value="0.022533"/>
  <xacro:property name="index_dip_len" value="0.020385"/>
  <xacro:property name="middle_mcp_len" value="0.029532"/>
  <xacro:property name="middle_pip_len" value="0.026913"/>
  <xacro:property name="middle_dip_len" value="0.023940"/>
  <xacro:property name="ring_mcp_len" value="0.029291"/>
  <xacro:property name="ring_pip_len" value="0.019854"/>
  <xacro:property name="ring_dip_len" value="0.022077"/>
  <xacro:property name="little_mcp_len" value="0.017978"/>
  <xacro:property name="little_pip_len" value="0.020702"/>
  <xacro:property name="little_dip_len" value="0.019761"/>

  <!-- Cylinder radius: a visual estimate, not a measured value. -->
  <xacro:property name="thumb_cmc_radius" value="0.0065"/>
  <xacro:property name="thumb_mcp_radius" value="0.006"/>
  <xacro:property name="thumb_ip_radius" value="0.0055"/>
  <xacro:property name="mcp_radius" value="0.006"/>
  <xacro:property name="pip_radius" value="0.0055"/>
  <xacro:property name="dip_radius" value="0.005"/>

  <!-- Draw a cylinder of length ${length} from the link origin along local Z toward
       the next joint. This matches joint-origin translations of "0 0 -length". -->
  <xacro:macro name="cg_cylinder_link" params="name length radius">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="cg_pivot_link" params="name">
    <link name="${name}">
      <visual>
        <geometry>
          <sphere radius="0.006"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <!-- Shared index/middle/ring/little chain:
       wrist -> tilt (abduction) -> mcp (flexion) -> pip -> dip.
       Only each tilt joint origin (xyz/rpy) is hand- and finger-specific measured data.
       The mcp joint origin is always the identity transform in the hand model, at the
       same position as tilt, so it remains fixed. The hand model also defines a
       little-finger cmc_flex DOF before tilt without an Ergonomics value. It is
       absorbed by passing the origin already composed with its zero-angle rest pose;
       see the callers in left_hand.urdf.xacro and right_hand.urdf.xacro. -->
  <xacro:macro name="cg_finger" params="prefix finger reflect
      tilt_xyz tilt_rpy
      pip_xyz pip_rpy
      dip_xyz dip_rpy
      mcp_len pip_len dip_len">
    <joint name="${prefix}${finger}_tilt_joint" type="revolute">
      <parent link="${prefix}wrist"/>
      <child link="${prefix}${finger}_tilt_link"/>
      <origin xyz="${tilt_xyz}" rpy="${tilt_rpy}"/>
      <axis xyz="0 ${reflect} 0"/>
      <limit lower="${tilt_lower}" upper="${tilt_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_pivot_link name="${prefix}${finger}_tilt_link"/>

    <joint name="${prefix}${finger}_mcp_joint" type="revolute">
      <parent link="${prefix}${finger}_tilt_link"/>
      <child link="${prefix}${finger}_mcp_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${mcp_lower}" upper="${mcp_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}${finger}_mcp_link" length="${mcp_len}" radius="${mcp_radius}"/>

    <joint name="${prefix}${finger}_pip_joint" type="revolute">
      <parent link="${prefix}${finger}_mcp_link"/>
      <child link="${prefix}${finger}_pip_link"/>
      <origin xyz="${pip_xyz}" rpy="${pip_rpy}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${pip_lower}" upper="${pip_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}${finger}_pip_link" length="${pip_len}" radius="${pip_radius}"/>

    <joint name="${prefix}${finger}_dip_joint" type="revolute">
      <parent link="${prefix}${finger}_pip_link"/>
      <child link="${prefix}${finger}_dip_link"/>
      <origin xyz="${dip_xyz}" rpy="${dip_rpy}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${dip_lower}" upper="${dip_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}${finger}_dip_link" length="${dip_len}" radius="${dip_radius}"/>
  </xacro:macro>

  <!-- Thumb-specific chain:
       wrist -> cmc (flexion) -> tilt (abduction) -> mcp (flexion) -> ip.
       The tilt joint origin is always the identity transform in the hand model,
       at the same position as cmc, so it remains fixed. -->
  <xacro:macro name="cg_thumb" params="prefix reflect
      cmc_xyz cmc_rpy
      mcp_xyz mcp_rpy
      ip_xyz ip_rpy">
    <joint name="${prefix}thumb_cmc_joint" type="revolute">
      <parent link="${prefix}wrist"/>
      <child link="${prefix}thumb_cmc_link"/>
      <origin xyz="${cmc_xyz}" rpy="${cmc_rpy}"/>
      <axis xyz="0 ${reflect} 0"/>
      <limit lower="${thumb_cmc_lower}" upper="${thumb_cmc_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}thumb_cmc_link" length="${thumb_cmc_len}" radius="${thumb_cmc_radius}"/>

    <joint name="${prefix}thumb_tilt_joint" type="revolute">
      <parent link="${prefix}thumb_cmc_link"/>
      <child link="${prefix}thumb_tilt_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 ${reflect}"/>
      <limit lower="${thumb_tilt_lower}" upper="${thumb_tilt_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_pivot_link name="${prefix}thumb_tilt_link"/>

    <joint name="${prefix}thumb_mcp_joint" type="revolute">
      <parent link="${prefix}thumb_tilt_link"/>
      <child link="${prefix}thumb_mcp_link"/>
      <origin xyz="${mcp_xyz}" rpy="${mcp_rpy}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${thumb_mcp_lower}" upper="${thumb_mcp_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}thumb_mcp_link" length="${thumb_mcp_len}" radius="${thumb_mcp_radius}"/>

    <joint name="${prefix}thumb_ip_joint" type="revolute">
      <parent link="${prefix}thumb_mcp_link"/>
      <child link="${prefix}thumb_ip_link"/>
      <origin xyz="${ip_xyz}" rpy="${ip_rpy}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${thumb_ip_lower}" upper="${thumb_ip_upper}"
             effort="${joint_effort}" velocity="${joint_velocity}"/>
    </joint>
    <xacro:cg_cylinder_link name="${prefix}thumb_ip_link" length="${thumb_ip_len}" radius="${thumb_ip_radius}"/>
  </xacro:macro>

  <!-- Top-level macro that constructs the links and joint hierarchy for one hand.
       left_hand.urdf.xacro and right_hand.urdf.xacro pass their hand-specific measured
       values calculated from hand-specific reference-point geometry. reflect (right = 1,
       left = -1) applies only the left/right correction for tilt and thumb-cmc joint
       axis signs; joint origins are already hand-specific measured values and must not
       be reflected. See the comment above for details. -->
  <xacro:macro name="contact_glove_hand" params="prefix reflect
      thumb_cmc_xyz thumb_cmc_rpy
      thumb_mcp_xyz thumb_mcp_rpy
      thumb_ip_xyz thumb_ip_rpy
      index_tilt_xyz index_tilt_rpy
      index_pip_xyz index_pip_rpy
      index_dip_xyz index_dip_rpy
      middle_tilt_xyz middle_tilt_rpy
      middle_pip_xyz middle_pip_rpy
      middle_dip_xyz middle_dip_rpy
      ring_tilt_xyz ring_tilt_rpy
      ring_pip_xyz ring_pip_rpy
      ring_dip_xyz ring_dip_rpy
      little_tilt_xyz little_tilt_rpy
      little_pip_xyz little_pip_rpy
      little_dip_xyz little_dip_rpy">
    <link name="${prefix}wrist">
      <visual>
        <origin xyz="-0.035 0.015 -0.005" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.02 0.058"/>
        </geometry>
      </visual>
    </link>

    <xacro:cg_thumb prefix="${prefix}" reflect="${reflect}"
      cmc_xyz="${thumb_cmc_xyz}" cmc_rpy="${thumb_cmc_rpy}"
      mcp_xyz="${thumb_mcp_xyz}" mcp_rpy="${thumb_mcp_rpy}"
      ip_xyz="${thumb_ip_xyz}" ip_rpy="${thumb_ip_rpy}"/>

    <xacro:cg_finger prefix="${prefix}" finger="index" reflect="${reflect}"
      tilt_xyz="${index_tilt_xyz}" tilt_rpy="${index_tilt_rpy}"
      pip_xyz="${index_pip_xyz}" pip_rpy="${index_pip_rpy}"
      dip_xyz="${index_dip_xyz}" dip_rpy="${index_dip_rpy}"
      mcp_len="${index_mcp_len}" pip_len="${index_pip_len}" dip_len="${index_dip_len}"/>

    <xacro:cg_finger prefix="${prefix}" finger="middle" reflect="${reflect}"
      tilt_xyz="${middle_tilt_xyz}" tilt_rpy="${middle_tilt_rpy}"
      pip_xyz="${middle_pip_xyz}" pip_rpy="${middle_pip_rpy}"
      dip_xyz="${middle_dip_xyz}" dip_rpy="${middle_dip_rpy}"
      mcp_len="${middle_mcp_len}" pip_len="${middle_pip_len}" dip_len="${middle_dip_len}"/>

    <xacro:cg_finger prefix="${prefix}" finger="ring" reflect="${reflect}"
      tilt_xyz="${ring_tilt_xyz}" tilt_rpy="${ring_tilt_rpy}"
      pip_xyz="${ring_pip_xyz}" pip_rpy="${ring_pip_rpy}"
      dip_xyz="${ring_dip_xyz}" dip_rpy="${ring_dip_rpy}"
      mcp_len="${ring_mcp_len}" pip_len="${ring_pip_len}" dip_len="${ring_dip_len}"/>

    <xacro:cg_finger prefix="${prefix}" finger="little" reflect="${reflect}"
      tilt_xyz="${little_tilt_xyz}" tilt_rpy="${little_tilt_rpy}"
      pip_xyz="${little_pip_xyz}" pip_rpy="${little_pip_rpy}"
      dip_xyz="${little_dip_xyz}" dip_rpy="${little_dip_rpy}"
      mcp_len="${little_mcp_len}" pip_len="${little_pip_len}" dip_len="${little_dip_len}"/>
  </xacro:macro>
</robot>
