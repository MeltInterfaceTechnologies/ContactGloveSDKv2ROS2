# Command that makes a glove vibrate (SDK: VibrateGlove()). It takes effect as soon as it is published.
string id          # ID of the glove to vibrate
float32 frequency  # Vibration frequency [Hz]. Range: 100.0-500.0
float32 amplitude  # Vibration amplitude. Range: 0.0-1.0
float32 duration   # Vibration duration [s]. Range: 0.001-1.0
